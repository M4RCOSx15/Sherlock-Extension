{
  "manifest_version": 3,
  "name": "Sherlock Extension",
  "version": "0.0.1",
  "description": "Extensão para análise de páginas web",
  "permissions": ["tabs", "scripting", "activeTab"],
  "action": {
    "default_title": "Sherlock Code",
    "default_popup": "popup.html",
    "default_icon": "sherlock.png"
  },
 
  "icons": {
    "128": "sherlock.png"
  },
   "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
  
}