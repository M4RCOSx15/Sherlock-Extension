# ============================================================
# RASTRO — .gitignore
# ============================================================

# ----------------------------
# SEGREDOS — nunca comitar
# ----------------------------
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# ----------------------------
# Python / Backend
# ----------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/

# Distribuição / build
dist/
build/
*.egg-info/
*.egg
.eggs/

# Testes e cobertura
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# Mypy / Ruff / linters
.mypy_cache/
.ruff_cache/

# Playwright (browsers baixados localmente)
playwright-browsers/

# ----------------------------
# Node / Frontend (futuro)
# ----------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
.next/
out/

# ----------------------------
# IDEs e Editores
# ----------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----------------------------
# Artefatos legados (extensão Chrome antiga)
# Mantidos no repo por histórico, mas não são parte do SaaS
# ----------------------------
# manifest.json  ← deixar no repo por ora, apenas documentado aqui

# ----------------------------
# Logs e temporários
# ----------------------------
*.log
logs/
tmp/
temp/
