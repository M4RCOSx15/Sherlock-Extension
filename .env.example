# ============================================================
# RASTRO — Variáveis de Ambiente
# ============================================================
# INSTRUÇÕES:
#   1. Copie este arquivo: cp .env.example .env
#   2. Preencha os valores reais no .env (NUNCA comite o .env)
#   3. O .env.example é o único arquivo com variáveis que vai ao Git
# ============================================================

# ----------------------------
# Configurações Gerais da API
# (Necessário a partir da Sprint 6)
# ----------------------------

# Ambiente de execução: "development" ou "production"
APP_ENV=development

# Porta em que o FastAPI vai escutar
APP_PORT=8000

# Origens permitidas no CORS (separadas por vírgula)
# Em dev, pode ser "*". Em produção, use o domínio real.
CORS_ORIGINS=http://localhost:8000

# ----------------------------
# Configurações do Playwright / Scraper
# (Necessário a partir da Sprint 8)
# ----------------------------

# Timeout máximo por requisição de scraping (em milissegundos)
SCRAPER_TIMEOUT_MS=15000

# Espera limitada após DOMContentLoaded para SPAs concluírem a renderização (0–5000 ms)
SCRAPER_RENDER_WAIT_MS=1800

# Número máximo de análises simultâneas (recomendado: 1 no MVP)
SCRAPER_MAX_CONCURRENT=1

# ----------------------------
# Provedor de análise semântica (opcional)
# Só envia texto limitado da página ao provedor quando LLM_ENABLED=true.
# ----------------------------

# Mantenha desligado até configurar provedor e chave no .env local.
LLM_ENABLED=false
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_TIMEOUT_SECONDS=30

# Para usar Qwen via DashScope, configure:
# LLM_PROVIDER=qwen
# LLM_MODEL=qwen3.8-flash
# LLM_BASE_URL=https://maas.qwencloudapi.com/compatible-mode/v1
# LLM_API_KEY=sua-chave-do-Model-Studio

# DASHSCOPE_API_KEY continua sendo aceita como nome antigo para compatibilidade.

# ----------------------------
# Configurações de Deploy
# (Necessário SOMENTE ao subir na VPS — Oracle Cloud)
# ----------------------------

# IP ou hostname da VPS
VPS_HOST=your-vps-ip-here

# Usuário SSH da VPS
VPS_USER=ubuntu
